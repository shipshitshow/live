# ── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/analytics
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/analytics

# ── YouTube (OAuth for analytics/comments + API key for public reads) ─────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Leave unset to derive the redirect URI from the request origin. Set explicitly
# to pin it. In production this must match an Authorized redirect URI in the
# Google Cloud Console OAuth client (e.g. https://live.shipshit.dev/api/auth/youtube/callback).
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/youtube/callback
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID_MAIN=
YOUTUBE_CHANNEL_ID_CLIPS=
# Fallback refresh tokens (the app also persists tokens to KV / TOKEN_FILE_PATH
# after an in-app reconnect).
YOUTUBE_REFRESH_TOKEN_MAIN=
YOUTUBE_REFRESH_TOKEN_CLIPS=
# Secret used to HMAC-sign the OAuth state parameter (CSRF protection). Falls
# back to YOUTUBE_CLIENT_SECRET if unset; set a dedicated random value in prod.
OAUTH_STATE_SECRET=

# ── AI comment-reply drafts (OpenAI-compatible; OpenRouter supported) ─────────
# OpenAI: leave OPENAI_BASE_URL unset, OPENAI_MODEL=gpt-4o-mini.
# OpenRouter: OPENAI_API_KEY = your OpenRouter key, OPENAI_BASE_URL below, and a
# provider-prefixed cheap model (e.g. google/gemini-2.0-flash-001).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ── X / Twitter (trends + per-episode author-post metrics) ──────────────────
# App-only bearer token. Reads are billed per post per UTC day; unset simply
# turns the episode X panel into manual entry.
X_BEARER_TOKEN=

# ── Social performance (optional; degrade to empty when unset) ───────────────
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/social/instagram/callback
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/social/tiktok/callback
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=

# ── Storage (Vercel KV + Blob) ───────────────────────────────────────────────
# KV caches access tokens and stores reconnected refresh tokens. On Vercel these
# are injected by the KV integration; unset locally the app falls back to files.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
# Required for writable livestream storage on Vercel (read-only runtime otherwise).
BLOB_READ_WRITE_TOKEN=

# ── Local runtime path overrides (optional) ──────────────────────────────────
# DATA_DIR — livestream data dir (default: <cwd>/data/livestream)
# APP_DATA_DIR — app data root
# SHIPSHIT_RUNTIME_DIR — writable runtime dir for logs/caches
# TOKEN_FILE_PATH — YouTube token file (default: <cwd>/data/youtube-tokens.json)
# SOCIAL_TOKEN_FILE_PATH — social token file
