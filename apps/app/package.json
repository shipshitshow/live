{
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@shipshitshow/talking-points": "workspace:*",
    "@shipshitshow/types": "workspace:*",
    "@shipshitshow/ui": "workspace:*",
    "@tailwindcss/postcss": "4.2.4",
    "@vercel/blob": "^2.3.3",
    "@vercel/kv": "3.0.0",
    "date-fns": "4.1.0",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "3.8.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@types/node": "25",
    "@types/react": "19",
    "@types/react-dom": "19",
    "knip": "6.7.0",
    "madge": "8.0.0",
    "postcss": "8",
    "sass": "1.99.0",
    "tailwindcss": "4.2.4"
  },
  "knip": {
    "entry": [
      "src/app/**/page.tsx",
      "src/app/**/layout.tsx",
      "src/app/**/route.ts"
    ],
    "project": [
      "src/**/*.{ts,tsx}"
    ]
  },
  "name": "@shipshitshow/app",
  "private": true,
  "scripts": {
    "build": "next build",
    "check:cycles": "madge --extensions ts,tsx --ts-config ./tsconfig.json --circular src",
    "check:types": "tsc --noEmit",
    "check:unused": "knip",
    "dev": "next dev -p 3001",
    "start": "next start -p 3001"
  },
  "version": "0.1.0"
}
