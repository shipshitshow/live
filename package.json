{
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@tailwindcss/postcss": "4.2.2",
    "@vercel/kv": "3.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "1.8.0",
    "next": "16.2.3",
    "node-pty": "1.1.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "3.8.1",
    "tailwind-merge": "3.5.0",
    "winston": "3.19.0",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "25",
    "@types/react": "19",
    "@types/react-dom": "19",
    "husky": "9.1.7",
    "knip": "6.4.1",
    "madge": "8.0.0",
    "postcss": "8",
    "sass": "1.99.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2"
  },
  "knip": {
    "entry": [
      "src/app/**/page.tsx",
      "src/app/**/layout.tsx",
      "src/app/**/route.ts"
    ],
    "project": [
      "src/**/*.{ts,tsx}"
    ]
  },
  "name": "live.shipshitshow.com",
  "packageManager": "bun@1.3.12",
  "private": true,
  "scripts": {
    "biome:check": "biome check .",
    "biome:write": "biome check --write .",
    "build": "next build",
    "check:cycles": "madge --extensions ts,tsx --ts-config ./tsconfig.json --circular src",
    "check:types": "tsc --noEmit",
    "check:unused": "knip",
    "deps:update": "bunx npm-check-updates -u --deep && bun install",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "prepare": "bunx husky",
    "start": "next start -p 3001"
  },
  "version": "0.1.0"
}
