{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "BLOB_READ_WRITE_TOKEN",
        "CLERK_SECRET_KEY",
        "INSTAGRAM_ACCESS_TOKEN",
        "INSTAGRAM_ACCOUNT_ID",
        "INSTAGRAM_CLIENT_ID",
        "INSTAGRAM_CLIENT_SECRET",
        "INSTAGRAM_OAUTH_REDIRECT_URI",
        "KV_REST_API_READ_ONLY_TOKEN",
        "KV_REST_API_TOKEN",
        "KV_REST_API_URL",
        "KV_URL",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL",
        "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
        "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL",
        "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
        "NEXT_PUBLIC_SITE_URL",
        "OAUTH_STATE_SECRET",
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL",
        "OPENAI_MODEL",
        "PIPELINE_API_URL",
        "POSTHOG_API_KEY",
        "POSTHOG_HOST",
        "POSTHOG_PROJECT_ID",
        "REDIS_URL",
        "SOCIAL_TOKEN_FILE_PATH",
        "TIKTOK_ACCESS_TOKEN",
        "TIKTOK_CLIENT_KEY",
        "TIKTOK_CLIENT_SECRET",
        "TIKTOK_OAUTH_REDIRECT_URI",
        "TIKTOK_OPEN_ID",
        "TIKTOK_REFRESH_TOKEN",
        "TOKEN_FILE_PATH",
        "VERCEL",
        "X_BEARER_TOKEN",
        "YOUTUBE_API_KEY",
        "YOUTUBE_CHANNEL_ID_CLIPS",
        "YOUTUBE_CHANNEL_ID_MAIN",
        "YOUTUBE_CLIENT_ID",
        "YOUTUBE_CLIENT_SECRET",
        "YOUTUBE_OAUTH_REDIRECT_URI",
        "YOUTUBE_REFRESH_TOKEN_CLIPS",
        "YOUTUBE_REFRESH_TOKEN_MAIN"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**"]
    },
    "check:types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
